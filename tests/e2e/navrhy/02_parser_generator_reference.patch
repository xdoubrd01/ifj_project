+static FuncInfo *find_func_info(const char *name) {
+    for (size_t i = 0; i < func_info_count; i++) {
+        if (strcmp(func_infos[i].name, name) == 0) {
+            return &func_infos[i];
+        }
+    }
+    return NULL;
+}
+
+// true, pokud se z funkce from lze volanim dostat do funkce target.
+static bool reaches(FuncInfo *from, FuncInfo *target, bool *visited) {
+    for (size_t i = 0; i < from->callee_count; i++) {
+        FuncInfo *next = find_func_info(from->callees[i]);
+        if (next == NULL) {
+            continue;
+        }
+        if (next == target) {
+            return true;
+        }
+        if (!visited[next - func_infos]) {
+            visited[next - func_infos] = true;
+            if (reaches(next, target, visited)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+// Primo i neprimo rekurzivni funkce musi mit uvedeny navratovy typ.
+static void check_inferred_recursion(void) {
+    for (size_t i = 0; i < func_info_count; i++) {
+        if (func_infos[i].typed) {
+            continue;
+        }
+        bool *visited = calloc(func_info_count, sizeof(bool));
+        if (visited == NULL) exit(99);
+        bool recursive = reaches(&func_infos[i], &func_infos[i], visited);
+        free(visited);
+        if (recursive) exit(6);
+    }
+}
+
+static bool has_unresolved_function(void) {
+    for (size_t i = 0; i < func_info_count; i++) {
+        if (!func_infos[i].typed) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool callees_resolved(const FuncInfo *info) {
+    for (size_t i = 0; i < info->callee_count; i++) {
+        const FuncInfo *callee = find_func_info(info->callees[i]);
+        if (callee != NULL && !callee->typed) {
+            return false;
+        }
+    }
+    return true;
+}
