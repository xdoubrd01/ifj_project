.IFJcode26
DEFVAR GF@%tmp_op1
DEFVAR GF@%tmp_op2
DEFVAR GF@%tmp_res
JUMPI $run
LABEL $print
CREATEFRAME
PUSHFRAME
DEFVAR LF@%val
POPS LF@%val
DEFVAR LF@%type
TYPE LF@%type LF@%val
JUMPIFNEQ $$print_not_nil LF@%type string@nil
WRITE string@()
PUSHS nil@nil
POPFRAME
RETURN
LABEL $$print_not_nil
WRITE LF@%val
PUSHS nil@nil
POPFRAME
RETURN
LABEL $readInt
CREATEFRAME
PUSHFRAME
DEFVAR LF@%val
READ LF@%val int
JUMPIFNEQ $$read_int_ok LF@%val nil@nil
MOVE LF@%val int@0
LABEL $$read_int_ok
PUSHS LF@%val
POPFRAME
RETURN
LABEL $readDouble
CREATEFRAME
PUSHFRAME
DEFVAR LF@%res
READ LF@%res float
JUMPIFNEQ $$read_double_ok LF@%res nil@nil
MOVE LF@%res float@0x0p+0
LABEL $$read_double_ok
PUSHS LF@%res
POPFRAME
RETURN
LABEL $toStr
CREATEFRAME
PUSHFRAME
DEFVAR LF@%val
DEFVAR LF@%type
DEFVAR LF@%res
POPS LF@%val
TYPE LF@%type LF@%val
JUMPIFEQ $$to_str_int LF@%type string@int
JUMPIFEQ $$to_str_float LF@%type string@float
JUMPIFEQ $$to_str_unit LF@%type string@nil
JUMPIFEQ $$to_str_bool LF@%type string@bool
MOVE LF@%res LF@%val
JUMP $$to_str_end
LABEL $$to_str_int
INT2STR LF@%res LF@%val
JUMP $$to_str_end
LABEL $$to_str_float
FLOAT2STR LF@%res LF@%val
JUMP $$to_str_end
LABEL $$to_str_unit
MOVE LF@%res string@()
JUMP $$to_str_end
LABEL $$to_str_bool
JUMPIFEQ $$to_str_bool_true LF@%val bool@true
MOVE LF@%res string@false
JUMP $$to_str_end
LABEL $$to_str_bool_true
MOVE LF@%res string@true
LABEL $$to_str_end
PUSHS LF@%res
POPFRAME
RETURN
LABEL $ord
CREATEFRAME
PUSHFRAME
DEFVAR LF@%str
DEFVAR LF@%idx
DEFVAR LF@%len
DEFVAR LF@%cond
DEFVAR LF@%res
POPS LF@%idx
POPS LF@%str
LT LF@%cond LF@%idx int@0
JUMPIFEQ $$ord_invalid LF@%cond bool@true
STRLEN LF@%len LF@%str
LT LF@%cond LF@%idx LF@%len
JUMPIFNEQ $$ord_invalid LF@%cond bool@true
STRI2INT LF@%res LF@%str LF@%idx
JUMP $$ord_end
LABEL $$ord_invalid
MOVE LF@%res int@-1
LABEL $$ord_end
PUSHS LF@%res
POPFRAME
RETURN
LABEL $subStr
CREATEFRAME
PUSHFRAME
DEFVAR LF@%str
DEFVAR LF@%start
DEFVAR LF@%end
DEFVAR LF@%len
DEFVAR LF@%cond
DEFVAR LF@%res
DEFVAR LF@%char
POPS LF@%end
POPS LF@%start
POPS LF@%str
STRLEN LF@%len LF@%str
LT LF@%cond LF@%start int@0
JUMPIFEQ $$substr_err LF@%cond bool@true
LT LF@%cond LF@%end int@0
JUMPIFEQ $$substr_err LF@%cond bool@true
GT LF@%cond LF@%start LF@%end
JUMPIFEQ $$substr_err LF@%cond bool@true
LT LF@%cond LF@%start LF@%len
JUMPIFNEQ $$substr_err LF@%cond bool@true
GT LF@%cond LF@%end LF@%len
JUMPIFEQ $$substr_err LF@%cond bool@true
MOVE LF@%res string@
LABEL $$substr_loop
JUMPIFEQ $$substr_end LF@%start LF@%end
GETCHAR LF@%char LF@%str LF@%start
CONCAT LF@%res LF@%res LF@%char
ADD LF@%start LF@%start int@1
JUMP $$substr_loop
LABEL $$substr_err
EXIT int@40
LABEL $$substr_end
PUSHS LF@%res
POPFRAME
RETURN
LABEL $strLength
CREATEFRAME
PUSHFRAME
DEFVAR LF@value
POPS LF@value
DEFVAR LF@%retval
STRLEN LF@%retval LF@value
PUSHS LF@%retval
POPFRAME
RETURN
LABEL $chr
CREATEFRAME
PUSHFRAME
DEFVAR LF@code
POPS LF@code
DEFVAR LF@%retval
INT2CHAR LF@%retval LF@code
PUSHS LF@%retval
POPFRAME
RETURN
LABEL $readLine
CREATEFRAME
PUSHFRAME
DEFVAR LF@%retval
READ LF@%retval string
JUMPIFNEQ $readLine_end LF@%retval nil@nil
MOVE LF@%retval string@
LABEL $readLine_end
PUSHS LF@%retval
POPFRAME
RETURN
LABEL $toInt
CREATEFRAME
PUSHFRAME
DEFVAR LF@value
POPS LF@value
DEFVAR LF@%retval
FLOAT2INT LF@%retval LF@value
PUSHS LF@%retval
POPFRAME
RETURN
EXIT int@0
LABEL $run
CREATEFRAME
PUSHFRAME
CALL $readInt
PUSHS LF@v0
CALL $print
LABEL $run$end
PUSHS nil@nil
POPFRAME
RETURN
