BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# Zarovnání operátorů, přiřazení a komentářů do sloupců
AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: true
AlignTrailingComments: true

# Složené závorky VŽDY na stejném řádku (za funkcí, ifem, cyklem, enumem)
BreakBeforeBraces: Attach

# Mezery pro přehlednost
SpaceBeforeParens: ControlStatements
SpacesInContainerLiterals: true